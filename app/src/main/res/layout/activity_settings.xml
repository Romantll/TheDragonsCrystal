<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/settings_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-1dp"
        android:layout_marginTop="1dp"
        android:scaleType="centerCrop"
        android:src="@drawable/basic_background" />

    <ImageButton
        android:id="@+id/home_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="31dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/home_button"
        android:scaleType="centerInside"
        android:src="@drawable/button_home2" />

    <Button
        android:id="@+id/reset_progress_button"
        android:layout_width="269dp"
        android:layout_height="wrap_content"
        android:background="@drawable/button_purple_rounded"
        android:text="Reset All Progress"
        android:textColor="@color/white"
        android:textStyle="normal"
        android:textSize="18sp"
        android:padding="10dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="64dp"/>
</RelativeLayout>
